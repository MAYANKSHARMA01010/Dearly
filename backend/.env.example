# Server
PORT=8080
BACKEND_LOCAL_URL=http://localhost:8080
# Future hosted Dearly backend; intentionally empty until supplied.
BACKEND_SERVER_URL=
NODE_ENV=development
HOST=127.0.0.1
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
# Direct local requests: 0. Set only after reviewing a future hosting proxy layout.
TRUST_PROXY_HOPS=0

# Client URLs (CORS)
FRONTEND_URL=http://localhost:8081
CLIENT_URL=http://localhost:3000

# PostgreSQL Database (Prisma) — copy your Neon URL into backend/.env only
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require"

# Optional future cache; Redis is not connected or required by the runtime yet.
# Existing REDIS_URL remains a local-only compatibility alias.
REDIS_LOCAL_URL="redis://localhost:6379"
REDIS_SERVER_URL=
# Use redis://redis:6379 only when the backend runs in Docker on the same network
# as a service named redis. HTTPS web-app URLs are not Redis connection strings.

# Authentication is disabled by default. Local simulation requires loopback HOST,
# non-production NODE_ENV, AUTH_MODE=development and a private random 32-byte key.
AUTH_MODE=disabled
# Real login: AUTH_MODE=whatsapp with configured WHATSAPP_MODE=waha below.
# Persistent OTP sender quota, separate from scheduled messages. No automatic resend.
WHATSAPP_OTP_DAILY_LIMIT=20
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# OTP_PEPPER=<64 lowercase hex characters; keep in private .env only>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Private filesystem storage (never expose through express.static).
# Relative paths resolve from backend/. Use a persistent private directory when hosted.
STORAGE_ROOT=./data/attachments
# ffprobe must be installed on PATH, or set an absolute executable path.
FFPROBE_PATH=ffprobe

# Email transport. Configuration alone does not enable scheduled email delivery.
EMAIL_MODE=disabled
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Use a dedicated Gmail account with 2-Step Verification and an app password.
# Store the app password without its display spaces. Never use the account password.
# SMTP_USER=your-account@gmail.com
# SMTP_FROM=your-account@gmail.com
# SMTP_PASSWORD=<private app password; backend/.env only>

# Local links work only on this computer. Set an accessible HTTPS origin when hosted.
# EMAIL_PUBLIC_URL=http://localhost:8080
# Separate random key: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# EXTERNAL_ACCESS_SECRET=<64 lowercase hex characters; backend/.env only>
# Conservative rolling 24-hour sender budget, including uncertain submissions.
EMAIL_DAILY_LIMIT=100

# WhatsApp: private WAHA Core service, no paid features or automatic channel fallback.
WHATSAPP_MODE=disabled
WAHA_LOCAL_API_URL=http://localhost:3100
# Production selects ONLY this server URL; leave empty until hosting is configured.
WAHA_SERVER_API_URL=
WAHA_SESSION=default
WAHA_ENGINE=GOWS
WAHA_DAILY_LIMIT=20
# WAHA_API_KEY=<private random key; at least 16 characters>
# WAHA_WEBHOOK_SECRET=<separate private 64 hex characters>
# WAHA_CALLBACK_URL=https://YOUR_BACKEND_HOST/webhooks/waha
# CONTENT_PUBLIC_URL=https://YOUR_BACKEND_HOST
# EMAIL_PUBLIC_URL remains a compatible alias for the shared content origin.
# Set a pinned WAHA Core image for your server architecture before Docker Compose.
# WAHA_IMAGE=devlikeapro/waha@sha256:<verified image digest>

# Phase 14: free SMSGate software, a real Android/SIM and an existing SMS plan.
# No SMS is sent until explicitly enabled with complete private configuration.
SMS_PROVIDER=disabled
SMSGATE_CONNECTION=cloud
# Gateway used by the local backend; the Android phone connects over internet.
SMSGATE_LOCAL_API_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_SERVER_API_URL=
# Required in cloud mode; optional extra pin for the direct local phone:
# SMSGATE_DEVICE_ID=<exact dedicated sending device ID>
# SMSGATE_USERNAME=<Cloud Server username>
# SMSGATE_PASSWORD=<Cloud Server password>
# Cloud JWT alternative (do not set together with username/password):
# SMSGATE_TOKEN=<private scoped bearer token>
# SMSGATE_WEBHOOK_SECRET=<copy the device's webhook signing key privately>
SMSGATE_SIM_NUMBER=1
SMS_DAILY_LIMIT=20
# SMSGATE_CALLBACK_URL=https://YOUR_REACHABLE_BACKEND/webhooks/smsgate

# Phase 15: explicit opt-in; no push sent without a configured app project.
PUSH_PROVIDER=disabled
EXPO_PROJECT_ID=
EXPO_ACCESS_TOKEN=

# Release only: assert a real persistent private storage mount after provisioning.
PERSISTENT_STORAGE_CONFIRMED=false
# Separate 32-byte random hex key for encrypted backups; keep private and backed up.
# BACKUP_ENCRYPTION_KEY=<64 lowercase hex characters>
# RESTORE_DATABASE_URL and RESTORE_STORAGE_ROOT must point to empty isolated targets.

# Hosted media: Neon private object storage (no separate storage account).
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=neon
# NEON_STORAGE_ENDPOINT=https://br-YOUR_BRANCH.storage.c-1.ap-southeast-1.aws.neon.tech
# NEON_STORAGE_REGION=ap-southeast-1
# NEON_STORAGE_ACCESS_KEY_ID=<private Neon storage credential ID>
# NEON_STORAGE_SECRET_ACCESS_KEY=<private Neon storage credential secret>
# NEON_STORAGE_BUCKET=dearly-private
# With Neon storage, STORAGE_ROOT is a disposable private cache, not the source of truth.

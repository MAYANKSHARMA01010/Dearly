# SINGLE BACKEND TEMPLATE — copy to ignored backend/.env and supply values privately.
# Disabled local providers make a fresh checkout safe. Hosted/service settings are below.
# Public URLs are not credentials. Never put server secrets in EXPO_PUBLIC_* variables.

# Runtime / local API
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
BACKEND_LOCAL_URL=http://localhost:8080
BACKEND_SERVER_URL=https://dearly-z8zm.onrender.com
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=0
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# CORS applies to browser clients, not native app authentication.
FRONTEND_URL=http://localhost:8081
CLIENT_URL=http://localhost:3000

# Neon PostgreSQL — private pooled URL; preserve supplied SSL parameters.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require"

# Optional Redis (not connected by the current runtime).
# Local: REDIS_LOCAL_URL, then legacy REDIS_URL. Production: REDIS_SERVER_URL only.
REDIS_LOCAL_URL=redis://localhost:6379
REDIS_SERVER_URL=
# REDIS_URL=redis://localhost:6379
# redis://redis:6379 is only for containers sharing a network with service redis.

# Phone login — WhatsApp first. Disabled until private sender/key setup is complete.
AUTH_MODE=disabled
WHATSAPP_OTP_DAILY_LIMIT=20
# Development simulation requires loopback HOST and non-production NODE_ENV.
# OTP_PEPPER=<private 64 lowercase hex characters>

# Public recipient links — always hosted HTTPS, including local-worker sends.
CONTENT_PUBLIC_URL=https://dearly-z8zm.onrender.com
# Legacy alias; CONTENT_PUBLIC_URL then BACKEND_SERVER_URL take precedence.
# EMAIL_PUBLIC_URL=https://dearly-z8zm.onrender.com
# EXTERNAL_ACCESS_SECRET=<separate persistent private 64 lowercase hex characters>

# Gmail — local smtp; hosted Render uses relay. Never use an account password.
EMAIL_MODE=disabled
EMAIL_DAILY_LIMIT=100
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_USER=sender@example.com
# SMTP_FROM=sender@example.com
# SMTP_PASSWORD=<private Gmail app password without display spaces>
# EMAIL_RELAY_URL=https://br-YOUR_BRANCH-dearlymail.compute.c-1.ap-southeast-1.aws.neon.tech
# EMAIL_RELAY_SECRET=<independent private 64 lowercase hex characters>

# WhatsApp adapter — local/backend selection is independent of the mobile API target.
WHATSAPP_MODE=disabled
WAHA_LOCAL_API_URL=http://localhost:3100
WAHA_SERVER_API_URL=https://dearly-waha-singapore.onrender.com
# Migration only: preserve the old logical sender scope for this same paired session.
# Omit on a new unrelated sender. This field is ignored by a local development backend.
# WAHA_SERVER_SCOPE_ORIGIN=https://dearly-waha.onrender.com
WAHA_SESSION=default
WAHA_ENGINE=GOWS
WAHA_DAILY_LIMIT=20
# WAHA_API_KEY=<private plaintext client key, at least 16 characters>
# WAHA_WEBHOOK_SECRET=<separate private 64 lowercase hex characters>
# WAHA_CALLBACK_URL=https://dearly-z8zm.onrender.com/webhooks/waha
# Compose-only image input, not an AppConfig field; pin a verified digest.
# WAHA_IMAGE=devlikeapro/waha@sha256:<verified image digest>

# SMSGate Cloud — real Android/SIM required. Credentials never belong in the app.
SMS_PROVIDER=disabled
SMSGATE_CONNECTION=cloud
SMSGATE_LOCAL_API_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_SERVER_API_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_SIM_NUMBER=1
SMS_DAILY_LIMIT=20
# SMSGATE_DEVICE_ID=<dedicated sending device ID>
# SMSGATE_USERNAME=<private Cloud Server username>
# SMSGATE_PASSWORD=<private Cloud Server password>
# Cloud token is an alternative; never combine it with username/password.
# SMSGATE_TOKEN=<private scoped token>
# SMSGATE_WEBHOOK_SECRET=<actual private phone Signing Key, not example words>
# SMSGATE_CALLBACK_URL=https://dearly-z8zm.onrender.com/webhooks/smsgate

# Notifications — optional; login never requires notification permission.
PUSH_PROVIDER=disabled
EXPO_PROJECT_ID=
EXPO_ACCESS_TOKEN=

# Storage — local adapter for development; Neon objects for Render.
STORAGE_PROVIDER=local
STORAGE_ROOT=./data/attachments
FFPROBE_PATH=ffprobe
PERSISTENT_STORAGE_CONFIRMED=false
# NEON_STORAGE_ENDPOINT=https://br-YOUR_BRANCH.storage.c-1.ap-southeast-1.aws.neon.tech
# NEON_STORAGE_REGION=ap-southeast-1
# NEON_STORAGE_ACCESS_KEY_ID=<private credential ID>
# NEON_STORAGE_SECRET_ACCESS_KEY=<private credential secret>
# NEON_STORAGE_BUCKET=dearly-private

# Backup/restore tools — local operations only, not mobile/build configuration.
# BACKUP_ENCRYPTION_KEY=<independent private 64 lowercase hex characters>
# PG_DUMP_BIN=/absolute/path/to/compatible/pg_dump
# PG_RESTORE_BIN=/absolute/path/to/compatible/pg_restore
# RESTORE_DATABASE_URL=<separate EMPTY isolated target, never the live source>
# RESTORE_STORAGE_ROOT=<separate EMPTY isolated directory>

# Optional protected scheduled operations. Independent random 32-byte hex tokens.
# OPERATIONS_TOKEN=<64 lowercase hex characters, maintenance only>
# MONITORING_TOKEN=<different 64 lowercase hex characters, read-only status>
# Never use OTP/provider/session/signing credentials here. Unset disables endpoint.

# Public Android release destination (not a credential).
APP_DOWNLOAD_URL=https://github.com/MAYANKSHARMA01010/Dearly/releases
# Optional migration source, never a live restore target.
# SOURCE_STORAGE_ROOT=/absolute/path/to/old/attachments

# HOSTED EXPRESS BACKEND — explicit service selection; private values required
HOSTED_NODE_ENV="production"
HOSTED_HOST="0.0.0.0"
HOSTED_PORT="8080"
HOSTED_BACKEND_LOCAL_URL="http://localhost:8080"
HOSTED_BACKEND_SERVER_URL="https://dearly-z8zm.onrender.com"
HOSTED_LOG_LEVEL="info"
HOSTED_BODY_LIMIT_BYTES="1048576"
HOSTED_SHUTDOWN_TIMEOUT_MS="10000"
HOSTED_TRUST_PROXY_HOPS="1"
HOSTED_RATE_LIMIT_WINDOW_MS="900000"
HOSTED_RATE_LIMIT_MAX="100"
HOSTED_DATABASE_URL="postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require"
HOSTED_REDIS_SERVER_URL=""
HOSTED_AUTH_MODE="whatsapp"
HOSTED_OTP_PEPPER=""
HOSTED_WHATSAPP_OTP_DAILY_LIMIT="20"
HOSTED_CONTENT_PUBLIC_URL="https://dearly-z8zm.onrender.com"
HOSTED_EXTERNAL_ACCESS_SECRET=""
HOSTED_EMAIL_MODE="relay"
HOSTED_EMAIL_RELAY_URL=""
HOSTED_EMAIL_RELAY_SECRET=""
HOSTED_SMTP_USER=""
HOSTED_SMTP_FROM=""
HOSTED_EMAIL_DAILY_LIMIT="100"
HOSTED_WHATSAPP_MODE="waha"
HOSTED_WAHA_SERVER_API_URL="https://dearly-waha-singapore.onrender.com"
HOSTED_WAHA_API_KEY=""
HOSTED_WAHA_WEBHOOK_SECRET=""
HOSTED_WAHA_CALLBACK_URL="https://dearly-z8zm.onrender.com/webhooks/waha"
HOSTED_WAHA_SESSION="default"
HOSTED_WAHA_ENGINE="GOWS"
HOSTED_WAHA_DAILY_LIMIT="20"
HOSTED_SMS_PROVIDER="smsgate"
HOSTED_SMSGATE_CONNECTION="cloud"
HOSTED_SMSGATE_SERVER_API_URL="https://api.sms-gate.app/3rdparty/v1"
HOSTED_SMSGATE_DEVICE_ID=""
HOSTED_SMSGATE_USERNAME=""
HOSTED_SMSGATE_PASSWORD=""
HOSTED_SMSGATE_WEBHOOK_SECRET=""
HOSTED_SMSGATE_CALLBACK_URL="https://dearly-z8zm.onrender.com/webhooks/smsgate"
HOSTED_SMSGATE_SIM_NUMBER="1"
HOSTED_SMS_DAILY_LIMIT="20"
HOSTED_PUSH_PROVIDER="disabled"
HOSTED_EXPO_PROJECT_ID=""
HOSTED_EXPO_ACCESS_TOKEN=""
HOSTED_STORAGE_PROVIDER="neon"
HOSTED_STORAGE_ROOT="/tmp/dearly-attachments"
HOSTED_PERSISTENT_STORAGE_CONFIRMED="false"
HOSTED_FFPROBE_PATH="ffprobe"
HOSTED_NEON_STORAGE_ENDPOINT=""
HOSTED_NEON_STORAGE_REGION="ap-southeast-1"
HOSTED_NEON_STORAGE_ACCESS_KEY_ID=""
HOSTED_NEON_STORAGE_SECRET_ACCESS_KEY=""
HOSTED_NEON_STORAGE_BUCKET="dearly-private"
HOSTED_BACKUP_ENCRYPTION_KEY=""
HOSTED_APP_DOWNLOAD_URL=https://github.com/MAYANKSHARMA01010/Dearly/releases

# LOCAL WAHA SERVICE — service-only keys; preserve paired identities
LOCAL_WAHA_SERVICE_PORT="3000"
LOCAL_WAHA_SERVICE_WHATSAPP_API_PORT="3000"
LOCAL_WAHA_SERVICE_WHATSAPP_DEFAULT_ENGINE="GOWS"
LOCAL_WAHA_SERVICE_WAHA_API_KEY="sha512:<128 lowercase hex characters derived privately from client key>"
LOCAL_WAHA_SERVICE_WAHA_DASHBOARD_ENABLED="false"
LOCAL_WAHA_SERVICE_WHATSAPP_SWAGGER_ENABLED="false"
LOCAL_WAHA_SERVICE_WAHA_DASHBOARD_USERNAME="dearly-admin"
LOCAL_WAHA_SERVICE_WAHA_DASHBOARD_PASSWORD=""
LOCAL_WAHA_SERVICE_WHATSAPP_SWAGGER_USERNAME="dearly-admin"
LOCAL_WAHA_SERVICE_WHATSAPP_SWAGGER_PASSWORD=""
LOCAL_WAHA_SERVICE_WAHA_PRINT_QR="False"
LOCAL_WAHA_SERVICE_WAHA_LOG_LEVEL="error"
LOCAL_WAHA_SERVICE_WAHA_HTTP_LOG_LEVEL="error"
LOCAL_WAHA_SERVICE_WAHA_NAMESPACE="dearly"
LOCAL_WAHA_SERVICE_WAHA_SESSION_NAMESPACE="dearly"
LOCAL_WAHA_SERVICE_WAHA_WORKER_ID="dearly"
LOCAL_WAHA_SERVICE_WHATSAPP_RESTART_ALL_SESSIONS="True"
LOCAL_WAHA_SERVICE_WHATSAPP_SESSIONS_POSTGRESQL_URL=""
LOCAL_WAHA_SERVICE_WAHA_GOWS_DEVICE_REQUIRE_FULL_SYNC="false"
LOCAL_WAHA_SERVICE_WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_DAYS_LIMIT="0"
LOCAL_WAHA_SERVICE_WAHA_GOWS_DEVICE_HISTORY_SYNC_INITIAL_SYNC_MAX_MESSAGES_PER_CHAT="0"
LOCAL_WAHA_SERVICE_WAHA_GOWS_DEVICE_HISTORY_SYNC_RECENT_SYNC_DAYS_LIMIT="0"
# LOCAL_WAHA_SERVICE_WAHA_IMAGE=devlikeapro/waha@sha256:<verified digest>

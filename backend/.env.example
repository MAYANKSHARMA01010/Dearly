# Dearly backend configuration
# One file; shared values appear once. Do not upload the full file to any service.
# Use scripts/environment.mjs to select a service; never source this file into a mobile build.

# -----------------------------------------------------------------------------
# 01 · API runtime
# Shared limits; HOSTED overrides below apply only where the runtime differs.
# -----------------------------------------------------------------------------
NODE_ENV="development"
HOST="127.0.0.1"
PORT="8080"
BACKEND_LOCAL_URL="http://localhost:8080"
BACKEND_SERVER_URL="https://dearly-z8zm.onrender.com"
LOG_LEVEL="info"
BODY_LIMIT_BYTES="1048576"
SHUTDOWN_TIMEOUT_MS="10000"
TRUST_PROXY_HOPS="0"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX="100"
FRONTEND_URL="http://localhost:8081"
CLIENT_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 02 · Database and optional Redis
# Neon connection is shared. Redis URLs differ by network; no REDIS_URL alias.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require"
REDIS_LOCAL_URL="redis://localhost:6379"
REDIS_SERVER_URL=""

# -----------------------------------------------------------------------------
# 03 · Authentication and protected operations
# Independent secrets serve different security purposes. Never reuse or log them.
# -----------------------------------------------------------------------------
AUTH_MODE="disabled"
WHATSAPP_OTP_DAILY_LIMIT="20"
# OTP_PEPPER=
# OPERATIONS_TOKEN=
# MONITORING_TOKEN=

# -----------------------------------------------------------------------------
# 04 · Recipient access and app download
# Content origin defaults to BACKEND_SERVER_URL; override only for a different viewer.
# -----------------------------------------------------------------------------
# CONTENT_PUBLIC_URL=
# EXTERNAL_ACCESS_SECRET=
APP_DOWNLOAD_URL="https://github.com/MAYANKSHARMA01010/Dearly/releases"

# -----------------------------------------------------------------------------
# 05 · Gmail and hosted mail relay
# One Gmail account/password. From is derived from SMTP_USER; Render receives no SMTP password in relay mode.
# -----------------------------------------------------------------------------
EMAIL_MODE="disabled"
EMAIL_DAILY_LIMIT="100"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_RELAY_URL=
# EMAIL_RELAY_SECRET=

# -----------------------------------------------------------------------------
# 06 · WhatsApp client
# Shared sender credential; separate local/hosted endpoints and stable logical sender scope.
# -----------------------------------------------------------------------------
WHATSAPP_MODE="disabled"
WAHA_LOCAL_API_URL="http://localhost:3100"
WAHA_SERVER_API_URL="https://dearly-waha-singapore.onrender.com"
# WAHA_SERVER_SCOPE_ORIGIN=
WAHA_SESSION="default"
WAHA_ENGINE="GOWS"
WAHA_DAILY_LIMIT="20"
# WAHA_API_KEY=
# WAHA_WEBHOOK_SECRET=
# WAHA_CALLBACK_URL=
# Pin the verified free WAHA Core image digest; never use a floating tag.
# WAHA_IMAGE=

# -----------------------------------------------------------------------------
# 07 · SMSGate
# One Cloud endpoint/account used from local and hosted backends. SIM numbering starts at 1.
# -----------------------------------------------------------------------------
SMS_PROVIDER="disabled"
SMSGATE_CONNECTION="cloud"
SMSGATE_API_URL="https://api.sms-gate.app/3rdparty/v1"
SMSGATE_SIM_NUMBER="1"
SMS_DAILY_LIMIT="20"
# SMSGATE_DEVICE_ID=
# SMSGATE_USERNAME=
# SMSGATE_PASSWORD=
# SMSGATE_TOKEN=
# SMSGATE_WEBHOOK_SECRET=
# SMSGATE_CALLBACK_URL=

# -----------------------------------------------------------------------------
# 08 · Push notifications
# Expo identifiers are public; an optional access token remains backend-only.
# -----------------------------------------------------------------------------
PUSH_PROVIDER="disabled"
EXPO_PROJECT_ID=""
EXPO_ACCESS_TOKEN=""

# -----------------------------------------------------------------------------
# 09 · Private storage
# Neon object credentials are shared; local filesystem paths can differ by runtime.
# -----------------------------------------------------------------------------
STORAGE_PROVIDER="local"
STORAGE_ROOT="./data/attachments"
PERSISTENT_STORAGE_CONFIRMED="false"
FFPROBE_PATH="ffprobe"
# NEON_STORAGE_ENDPOINT=
# NEON_STORAGE_REGION=
# NEON_STORAGE_ACCESS_KEY_ID=
# NEON_STORAGE_SECRET_ACCESS_KEY=
# NEON_STORAGE_BUCKET=

# -----------------------------------------------------------------------------
# 10 · Backup and restore
# Independent encryption key. Restore targets must be empty and isolated from production.
# -----------------------------------------------------------------------------
# BACKUP_ENCRYPTION_KEY=
# PG_DUMP_BIN=
# PG_RESTORE_BIN=
# RESTORE_DATABASE_URL=
# RESTORE_STORAGE_ROOT=
# SOURCE_STORAGE_ROOT=

# -----------------------------------------------------------------------------
# 11 · Hosted API differences only
# Omitted shared keys are reused intentionally; local-only settings are never inherited.
# -----------------------------------------------------------------------------
HOSTED_EMAIL_MODE="relay"
HOSTED_HOST="0.0.0.0"
HOSTED_NODE_ENV="production"
HOSTED_SMSGATE_CALLBACK_URL="https://dearly-z8zm.onrender.com/webhooks/smsgate"
HOSTED_STORAGE_ROOT="/tmp/dearly-attachments"
HOSTED_TRUST_PROXY_HOPS="1"
HOSTED_WAHA_CALLBACK_URL="https://dearly-z8zm.onrender.com/webhooks/waha"

# -----------------------------------------------------------------------------
# 12 · WAHA gateway service
# Provider field aliases and hosted key verifier are derived by the selector; keep passwords distinct.
# -----------------------------------------------------------------------------
GATEWAY_ADMIN_USERNAME="dearly-admin"
GATEWAY_DASHBOARD_ENABLED="false"
HOSTED_GATEWAY_DASHBOARD_PASSWORD=""
HOSTED_GATEWAY_DATABASE_URL=""
GATEWAY_FULL_SYNC="false"
GATEWAY_HISTORY_FULL_DAYS="0"
GATEWAY_HISTORY_INITIAL_MESSAGES="0"
GATEWAY_HISTORY_RECENT_DAYS="0"
# Access-log severity labels every completed request; error would mark HTTP 200 as an error.
GATEWAY_HTTP_LOG_LEVEL="info"
GATEWAY_LOG_LEVEL="error"
HOSTED_GATEWAY_NAMESPACE="dearly"
GATEWAY_PORT="3000"
GATEWAY_PRINT_QR="False"
GATEWAY_RESTART_SESSIONS="True"
GATEWAY_SWAGGER_ENABLED="false"
HOSTED_GATEWAY_SWAGGER_PASSWORD=""
LOCAL_GATEWAY_WEB_VERSION=""
HOSTED_GATEWAY_WORKER_ID="dearly"

# -----------------------------------------------------------------------------
# 13 · Trusted local releases
# Release API origin is derived from BACKEND_SERVER_URL; do not duplicate it.
# -----------------------------------------------------------------------------
RELEASE_RENDER_SERVICE_ID="srv-dbvbkc67bikc7385bv8g"
RELEASE_DEPLOY_HOOK_FILE=""

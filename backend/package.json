{
  "name": "backend",
  "version": "1.6.1",
  "description": "Dearly Backend API with Node.js, Express, Prisma & PostgreSQL",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --signal SIGTERM --watch src --ext ts --exec \"tsx\" src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && tsc -p tsconfig.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p functions/tsconfig.neon.json",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "attachments:cleanup": "tsx src/jobs/cleanupAttachments.ts",
    "delivery:worker": "tsx src/workers/runDeliveryWorker.ts",
    "delivery:status": "tsx src/jobs/manageDelivery.ts",
    "delivery:retry": "tsx src/jobs/manageDelivery.ts retry",
    "email:verify": "tsx src/jobs/checkEmail.ts",
    "whatsapp:status": "tsx src/jobs/manageWhatsapp.ts status",
    "whatsapp:init": "tsx src/jobs/manageWhatsapp.ts init",
    "whatsapp:qr": "tsx src/jobs/manageWhatsapp.ts qr",
    "whatsapp:cleanup": "tsx src/jobs/manageWhatsapp.ts cleanup",
    "whatsapp:start": "tsx src/jobs/manageWhatsapp.ts start",
    "whatsapp:pair": "tsx src/jobs/manageWhatsapp.ts pair",
    "sms:status": "tsx src/jobs/manageSms.ts status",
    "sms:init": "tsx src/jobs/manageSms.ts init",
    "sms:cleanup": "tsx src/jobs/manageSms.ts cleanup",
    "sms:callback": "tsx src/jobs/runSmsCallback.ts",
    "push:worker": "tsx src/jobs/runPushWorker.ts",
    "release:check": "tsx src/jobs/checkRelease.ts",
    "ops:check": "tsx src/jobs/checkOperations.ts",
    "start:production": "node dist/jobs/checkRelease.js && node dist/server.js",
    "worker:production": "node dist/jobs/checkRelease.js && node dist/workers/runDeliveryWorker.js",
    "push:production": "node dist/jobs/checkRelease.js && node dist/jobs/runPushWorker.js --loop",
    "backup": "tsx src/jobs/manageBackup.ts",
    "test:backup-drill": "tsx tests/operations/backupDrill.ts",
    "storage:migrate": "tsx src/jobs/migrateStorage.ts",
    "start:hosted": "node dist/jobs/startHosted.js",
    "email:bundle": "node functions/build-mail.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "3.1172.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "libphonenumber-js": "^1.13.16",
    "nodemailer": "^10.6.0",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.1",
    "swagger-ui-dist": "5.35.1",
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "^10.0.1",
    "@neon/config": "1.14.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "^6.0.3",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    },
    "nodemon": {
      "minimatch": "^11.0.8"
    }
  }
}

# HOSTED RENDER TEMPLATE — private service settings, not a ready-to-run secret file.
# Intentionally incomplete: fill private values before validation/deployment.
# Existing local .env stays development. See docs/environment-setup.md.

# Runtime / hosted API (native clients do not need CORS entries)
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
BACKEND_LOCAL_URL=http://localhost:8080
BACKEND_SERVER_URL=https://dearly-z8zm.onrender.com
LOG_LEVEL=info
BODY_LIMIT_BYTES=1048576
SHUTDOWN_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# FRONTEND_URL=https://web-client.example.com
# CLIENT_URL=https://other-client.example.com
# For another host, review proxy hops rather than copying Render's value blindly.

# Database and optional internal Redis; never fall back to local in production.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_NEON_HOST/neondb?sslmode=require&channel_binding=require"
REDIS_SERVER_URL=
# REDIS_LOCAL_URL=redis://localhost:6379
# REDIS_URL=redis://localhost:6379

# Real phone login; separate quota from scheduled WhatsApp notifications.
AUTH_MODE=whatsapp
OTP_PEPPER=
WHATSAPP_OTP_DAILY_LIMIT=20
CONTENT_PUBLIC_URL=https://dearly-z8zm.onrender.com
EXTERNAL_ACCESS_SECRET=
# EMAIL_PUBLIC_URL=https://dearly-z8zm.onrender.com

# Gmail via the protected Neon function. SMTP_PASSWORD belongs to that function,
# not the Render backend when EMAIL_MODE=relay. No paid email provider is used.
EMAIL_MODE=relay
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=
SMTP_USER=
SMTP_FROM=
EMAIL_DAILY_LIMIT=100
# Self-managed hosts that allow SMTP may deliberately choose EMAIL_MODE=smtp:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_PASSWORD=<private Gmail app password>

# WhatsApp client settings; the separate WAHA service uses waha.env.example.
WHATSAPP_MODE=waha
WAHA_SERVER_API_URL=https://dearly-waha-singapore.onrender.com
# Migration only: preserve the old logical sender scope for this same paired session.
# Omit on a new unrelated sender. This field is ignored by a local development backend.
# WAHA_SERVER_SCOPE_ORIGIN=https://dearly-waha.onrender.com
# WAHA_LOCAL_API_URL=http://localhost:3100
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_CALLBACK_URL=https://dearly-z8zm.onrender.com/webhooks/waha
WAHA_SESSION=default
WAHA_ENGINE=GOWS
WAHA_DAILY_LIMIT=20
# WAHA_IMAGE=devlikeapro/waha@sha256:<verified image digest>

# Physical SMSGate sender. Set disabled if not provisioned; do not invent success.
SMS_PROVIDER=smsgate
SMSGATE_CONNECTION=cloud
SMSGATE_SERVER_API_URL=https://api.sms-gate.app/3rdparty/v1
# SMSGATE_LOCAL_API_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_DEVICE_ID=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
# SMSGATE_TOKEN=<private cloud token alternative; omit username/password>
SMSGATE_WEBHOOK_SECRET=
SMSGATE_CALLBACK_URL=https://dearly-z8zm.onrender.com/webhooks/smsgate
SMSGATE_SIM_NUMBER=1
SMS_DAILY_LIMIT=20

# Optional push; configure actual project identity privately before enabling.
PUSH_PROVIDER=disabled
EXPO_PROJECT_ID=
EXPO_ACCESS_TOKEN=

# Private Neon objects; Render filesystem is only a disposable cache.
STORAGE_PROVIDER=neon
STORAGE_ROOT=/tmp/dearly-attachments
PERSISTENT_STORAGE_CONFIRMED=false
FFPROBE_PATH=ffprobe
NEON_STORAGE_ENDPOINT=
NEON_STORAGE_REGION=ap-southeast-1
NEON_STORAGE_ACCESS_KEY_ID=
NEON_STORAGE_SECRET_ACCESS_KEY=
NEON_STORAGE_BUCKET=dearly-private

# Independent backup secret; keep an independent secure copy.
BACKUP_ENCRYPTION_KEY=
# Maintenance tools run on a trusted host with compatible PostgreSQL clients.
# PG_DUMP_BIN=/absolute/path/to/compatible/pg_dump
# PG_RESTORE_BIN=/absolute/path/to/compatible/pg_restore
# RESTORE_DATABASE_URL=<separate EMPTY isolated target>
# RESTORE_STORAGE_ROOT=<separate EMPTY isolated directory>

# Optional protected scheduled operations. Independent random 32-byte hex tokens.
# OPERATIONS_TOKEN=<64 lowercase hex characters, maintenance only>
# MONITORING_TOKEN=<different 64 lowercase hex characters, read-only status>
# Never use OTP/provider/session/signing credentials here. Unset disables endpoint.

# Template only. Copy to private backend/.env.production; never commit real values.
# Intentionally fails release:check until every required value is provisioned.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
BACKEND_LOCAL_URL=http://localhost:8080
BACKEND_SERVER_URL=
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_DATABASE_HOST/neondb?sslmode=require&channel_binding=require"
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=10000
STORAGE_ROOT=/var/lib/dearly/attachments
PERSISTENT_STORAGE_CONFIRMED=false
FFPROBE_PATH=ffprobe
AUTH_MODE=whatsapp
OTP_PEPPER=
WHATSAPP_OTP_DAILY_LIMIT=20
EMAIL_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_FROM=
SMTP_PASSWORD=
CONTENT_PUBLIC_URL=
EXTERNAL_ACCESS_SECRET=
EMAIL_DAILY_LIMIT=100
WHATSAPP_MODE=waha
WAHA_LOCAL_API_URL=http://localhost:3100
WAHA_SERVER_API_URL=
WAHA_API_KEY=
WAHA_WEBHOOK_SECRET=
WAHA_CALLBACK_URL=
WAHA_SESSION=default
WAHA_ENGINE=GOWS
WAHA_DAILY_LIMIT=20
SMS_PROVIDER=smsgate
SMSGATE_CONNECTION=cloud
SMSGATE_SERVER_API_URL=https://api.sms-gate.app/3rdparty/v1
SMSGATE_DEVICE_ID=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_WEBHOOK_SECRET=
SMSGATE_CALLBACK_URL=
SMSGATE_SIM_NUMBER=1
SMS_DAILY_LIMIT=20
PUSH_PROVIDER=expo
EXPO_PROJECT_ID=b19a93b4-f755-42ec-86a7-115c8b5ac098
# Set only if Expo project push access-token security is enabled.
# EXPO_ACCESS_TOKEN=<private token>
BACKUP_ENCRYPTION_KEY=
# Optional; runtime currently does not require Redis.
REDIS_LOCAL_URL=redis://localhost:6379
REDIS_SERVER_URL=
# Native clients need no CORS entries. Add HTTPS web origins only if used.
# FRONTEND_URL=https://YOUR_WEB_CLIENT
# CLIENT_URL=https://YOUR_OTHER_CLIENT

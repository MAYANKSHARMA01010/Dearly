generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  phone           String           @unique
  phoneVerifiedAt DateTime
  name            String?
  email           String?
  timezone        String           @default("UTC")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  drafts          DraftMessage[]   @relation("OwnedDrafts")
  draftTargets    DraftRecipient[] @relation("DraftTargets")
  attachments     Attachment[]
  inboxItems      InboxItem[]

  @@map("users")
}

// Persist throttles independently of individual challenges and process restarts.
model PhoneAuthState {
  phone           String   @id
  requestWindowAt DateTime
  requestCount    Int      @default(0)
  lastRequestedAt DateTime
  failureWindowAt DateTime
  failureCount    Int      @default(0)

  @@map("phone_auth_states")
}

model OtpChallenge {
  id                String    @id @default(uuid())
  phone             String
  codeHash          String
  attempts          Int       @default(0)
  expiresAt         DateTime
  consumedAt        DateTime?
  dispatchStatus    String    @default("pending")
  providerMessageId String?
  createdAt         DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model Session {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessHash      String         @unique
  accessExpiresAt DateTime
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())
  refreshTokens   RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Keep consumed refresh hashes until the session expires to detect replay.
model RefreshToken {
  hash      String    @id
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum MessageStatus {
  DRAFT
  SCHEDULED
  CANCELED
  DISPATCHING
  DELIVERED
  PARTIALLY_DELIVERED
  SUBMITTED
  PARTIALLY_SUBMITTED
  DELIVERY_UNKNOWN
  FAILED
}

enum RecipientType {
  SELF
  USER
  PHONE
  EMAIL
}

model DraftMessage {
  id         String           @id @default(uuid())
  ownerId    String
  owner      User             @relation("OwnedDrafts", fields: [ownerId], references: [id], onDelete: Cascade)
  status     MessageStatus    @default(DRAFT)
  subject    String?          @db.VarChar(160)
  text       String           @default("")
  occasion   String?          @db.VarChar(80)
  version    Int              @default(1)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  scheduledFor DateTime? @db.Timestamptz(3)
  scheduleTimezone String? @db.VarChar(80)
  scheduleLocalDateTime String? @db.VarChar(16)
  canceledAt DateTime? @db.Timestamptz(3)
  scheduleRequestHash String? @db.Char(64)
  deliveryEnabled Boolean @default(false)
  events MessageEvent[]
  deliveryWork DeliveryWork[]
  inboxItems InboxItem[]
  deliveryIntents DeliveryIntent[]
  attachments Attachment[]
  recipients DraftRecipient[]

  @@index([ownerId, status, createdAt, id])
  @@index([status, scheduledFor, id])
  @@map("draft_messages")
}

model DraftRecipient {
  id             String        @id @default(uuid())
  messageId      String
  message        DraftMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type           RecipientType
  destinationKey String
  position       Int
  label          String?       @db.VarChar(80)
  targetUserId   String?
  deliveryIntents DeliveryIntent[]
  targetUser     User?         @relation("DraftTargets", fields: [targetUserId], references: [id], onDelete: SetNull)
  phone          String?       @db.VarChar(16)
  country        String?       @db.Char(2)
  email          String?       @db.VarChar(254)

  @@unique([messageId, destinationKey])
  @@unique([id, messageId])
  @@index([messageId, position])
  @@index([targetUserId])
  @@map("draft_recipients")
}


enum AttachmentState {
  PENDING
  UPLOADING
  UPLOADED
  READY
  DELETING
}

model Attachment {
  id         String          @id
  ownerId    String
  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  draftId    String?
  draft      DraftMessage?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  name       String          @db.VarChar(120)
  mime       String          @db.VarChar(80)
  bytes      Int
  state      AttachmentState @default(PENDING)
  attemptId  String?
  sha256     String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  expiresAt  DateTime

  @@index([ownerId, draftId, state])
  @@index([state, expiresAt])
  @@map("attachments")
}


enum DeliveryChannel {
  IN_APP
  WHATSAPP
  SMS
  EMAIL
}

model DeliveryIntent {
  id String @id @default(uuid())
  messageId String
  message DraftMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipientId String
  recipient DraftRecipient @relation(fields: [recipientId, messageId], references: [id, messageId], onDelete: Cascade)
  channel DeliveryChannel
  consentAt DateTime? @db.Timestamptz(3)
  attempts DeliveryAttempt[]
  emailDelivery EmailDelivery?
  inboxItem InboxItem?

  @@unique([messageId, recipientId, channel])
  @@map("delivery_intents")
}


enum WorkState {
  READY
  RUNNING
  SUCCEEDED
  FAILED
  OBSOLETE
}

enum AttemptState {
  STARTED
  SUCCEEDED
  RETRYABLE_FAILED
  PERMANENT_FAILED
  ABANDONED
}

model DeliveryWork {
  id String @id @default(uuid())
  messageId String
  message DraftMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  scheduleVersion Int
  state WorkState @default(READY)
  attempts Int @default(0)
  attemptLimit Int @default(5)
  nextAttemptAt DateTime @db.Timestamptz(3)
  leaseToken String?
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  lastError String? @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deliveries DeliveryAttempt[]

  @@unique([messageId, scheduleVersion])
  @@index([state, nextAttemptAt])
  @@index([state, leaseExpiresAt])
  @@map("delivery_work")
}

model DeliveryAttempt {
  id String @id @default(uuid())
  workId String
  work DeliveryWork @relation(fields: [workId], references: [id], onDelete: Cascade)
  intentId String
  intent DeliveryIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  number Int
  state AttemptState @default(STARTED)
  errorCode String? @db.VarChar(40)
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)

  @@unique([workId, intentId, number])
  @@map("delivery_attempts")
}

model InboxItem {
  id String @id @default(uuid())
  intentId String @unique
  intent DeliveryIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  messageId String
  message DraftMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt DateTime @default(now()) @db.Timestamptz(3)
  openedAt DateTime? @db.Timestamptz(3)

  @@index([userId, deliveredAt, id])
  @@map("inbox_items")
}

model WorkerHeartbeat {
  id String @id
  startedAt DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)
  stoppedAt DateTime? @db.Timestamptz(3)

  @@index([lastSeenAt])
  @@map("worker_heartbeats")
}


enum MessageEventKind {
  EMAIL_LINK_REVOKED
  WHATSAPP_LINK_REVOKED
  WHATSAPP_NOTIFICATION_DELIVERED
  WHATSAPP_NOTIFICATION_READ
  WHATSAPP_NOTIFICATION_FAILED
  BASELINE
  CREATED
  EDITED
  SCHEDULED
  RESCHEDULED
  CANCELED
  REOPENED
  DISPATCH_STARTED
  RETRY_SCHEDULED
  RETRY_REQUESTED
  DELIVERED
  PARTIALLY_DELIVERED
  SUBMITTED
  PARTIALLY_SUBMITTED
  DELIVERY_UNKNOWN
  FAILED
  OPENED
}

model MessageEvent {
  id String @id @default(uuid())
  sequence BigInt @unique @default(autoincrement())
  messageId String
  message DraftMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  kind MessageEventKind
  state MessageStatus
  version Int
  occurredAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([messageId, sequence])
  @@map("message_events")
}


enum EmailState {
  SUBMITTING
  ACCEPTED
  REJECTED
  RETRYABLE
  UNKNOWN
}

model EmailDelivery {
  id String @id @default(uuid())
  intentId String @unique
  intent DeliveryIntent @relation(fields: [intentId], references: [id], onDelete: Cascade)
  state EmailState @default(SUBMITTING)
  providerMessageId String? @db.VarChar(255)
  providerScope String? @db.VarChar(64)
  notificationAck Int?
  notificationDeliveredAt DateTime? @db.Timestamptz(3)
  notificationReadAt DateTime? @db.Timestamptz(3)
  notificationErrorAt DateTime? @db.Timestamptz(3)
  errorCode String? @db.VarChar(40)
  submittedAt DateTime? @db.Timestamptz(3)
  openedAt DateTime? @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt
  @@unique([providerScope,providerMessageId])
  @@map("email_deliveries")
}

model EmailBudget {
  id String @id
  count Int @default(0)
  resetsAt DateTime @db.Timestamptz(3)
  @@map("email_budgets")
}


model WahaReceipt {
  id String @id @default(uuid())
  scope String @db.VarChar(64)
  eventId String @db.VarChar(128)
  providerMessageId String @db.VarChar(255)
  destination String? @db.VarChar(40)
  ack Int
  observedAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  appliedAt DateTime? @db.Timestamptz(3)
  @@unique([scope,eventId])
  @@index([scope,providerMessageId])
  @@index([expiresAt])
  @@map("waha_receipts")
}

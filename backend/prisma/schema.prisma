generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  phone           String           @unique
  phoneVerifiedAt DateTime
  name            String?
  email           String?
  timezone        String           @default("UTC")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  sessions        Session[]
  drafts          DraftMessage[]   @relation("OwnedDrafts")
  draftTargets    DraftRecipient[] @relation("DraftTargets")
  attachments     Attachment[]

  @@map("users")
}

// Persist throttles independently of individual challenges and process restarts.
model PhoneAuthState {
  phone           String   @id
  requestWindowAt DateTime
  requestCount    Int      @default(0)
  lastRequestedAt DateTime
  failureWindowAt DateTime
  failureCount    Int      @default(0)

  @@map("phone_auth_states")
}

model OtpChallenge {
  id                String    @id @default(uuid())
  phone             String
  codeHash          String
  attempts          Int       @default(0)
  expiresAt         DateTime
  consumedAt        DateTime?
  dispatchStatus    String    @default("pending")
  providerMessageId String?
  createdAt         DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model Session {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessHash      String         @unique
  accessExpiresAt DateTime
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime       @default(now())
  refreshTokens   RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Keep consumed refresh hashes until the session expires to detect replay.
model RefreshToken {
  hash      String    @id
  sessionId String
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([sessionId])
  @@map("refresh_tokens")
}

enum MessageStatus {
  DRAFT
}

enum RecipientType {
  SELF
  USER
  PHONE
  EMAIL
}

model DraftMessage {
  id         String           @id @default(uuid())
  ownerId    String
  owner      User             @relation("OwnedDrafts", fields: [ownerId], references: [id], onDelete: Cascade)
  status     MessageStatus    @default(DRAFT)
  subject    String?          @db.VarChar(160)
  text       String           @default("")
  occasion   String?          @db.VarChar(80)
  version    Int              @default(1)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  attachments Attachment[]
  recipients DraftRecipient[]

  @@index([ownerId, status, createdAt, id])
  @@map("draft_messages")
}

model DraftRecipient {
  id             String        @id @default(uuid())
  messageId      String
  message        DraftMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type           RecipientType
  destinationKey String
  position       Int
  label          String?       @db.VarChar(80)
  targetUserId   String?
  targetUser     User?         @relation("DraftTargets", fields: [targetUserId], references: [id], onDelete: SetNull)
  phone          String?       @db.VarChar(16)
  country        String?       @db.Char(2)
  email          String?       @db.VarChar(254)

  @@unique([messageId, destinationKey])
  @@index([messageId, position])
  @@index([targetUserId])
  @@map("draft_recipients")
}


enum AttachmentState {
  PENDING
  UPLOADING
  UPLOADED
  READY
  DELETING
}

model Attachment {
  id         String          @id
  ownerId    String
  owner      User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  draftId    String?
  draft      DraftMessage?   @relation(fields: [draftId], references: [id], onDelete: SetNull)
  name       String          @db.VarChar(120)
  mime       String          @db.VarChar(80)
  bytes      Int
  state      AttachmentState @default(PENDING)
  attemptId  String?
  sha256     String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  expiresAt  DateTime

  @@index([ownerId, draftId, state])
  @@index([state, expiresAt])
  @@map("attachments")
}

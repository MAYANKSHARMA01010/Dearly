# SEPARATE WAHA SERVICE TEMPLATE — not the Express backend environment.
# Pin the official image digest in service settings/Compose, not a floating tag.
PORT=3000
WHATSAPP_API_PORT=3000
WHATSAPP_DEFAULT_ENGINE=GOWS
# Backend WAHA_API_KEY is plaintext; this service stores only its SHA512 verifier.
WAHA_API_KEY=sha512:<128 lowercase hex characters derived privately from client key>
WAHA_DASHBOARD_ENABLED=false
WHATSAPP_SWAGGER_ENABLED=false
WAHA_DASHBOARD_USERNAME=dearly-admin
WAHA_DASHBOARD_PASSWORD=
WHATSAPP_SWAGGER_USERNAME=dearly-admin
WHATSAPP_SWAGGER_PASSWORD=
# Supply independent strong passwords even when disabled, to avoid startup generation/logging.
WAHA_PRINT_QR=False
WAHA_LOG_LEVEL=error
WAHA_HTTP_LOG_LEVEL=error
# Stable namespace/worker identity: preserve existing values for a paired sender.
WAHA_NAMESPACE=dearly
WAHA_SESSION_NAMESPACE=dearly
WAHA_WORKER_ID=dearly
WHATSAPP_RESTART_ALL_SESSIONS=True
WHATSAPP_SESSIONS_POSTGRESQL_URL=
# Dedicated WAHA database role/URL, never an application owner credential.
# Review connection mode against the exact engine; do not rewrite it while pairing.
WAHA_GOWS_DEVICE_REQUIRE_FULL_SYNC=false
WAHA_GOWS_DEVICE_HISTORY_SYNC_FULL_SYNC_DAYS_LIMIT=0
WAHA_GOWS_DEVICE_HISTORY_SYNC_INITIAL_SYNC_MAX_MESSAGES_PER_CHAT=0
WAHA_GOWS_DEVICE_HISTORY_SYNC_RECENT_SYNC_DAYS_LIMIT=0

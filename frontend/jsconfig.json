{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "checkJs": true,
    "maxNodeModuleJsDepth": 0,
    "strict": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "index.js", "nativewind-env.d.ts", "environment.d.ts"],
  "exclude": ["node_modules", "dist", ".expo", "android", "ios"]
}

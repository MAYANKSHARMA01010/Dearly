{
  "expo": {
    "name": "Dearly",
    "slug": "dearly",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mayanksharma.dearly",
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.mayanksharma.dearly",
      "googleServicesFile": "./google-services.json",
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Dearly to record a voice note when you choose Record voice.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Dearly to select a photo or video for your private draft.",
          "cameraPermission": false,
          "microphonePermission": "Allow Dearly to record a voice note when you choose Record voice."
        }
      ],
      "expo-asset",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "dearly",
    "owner": "manku_dada",
    "extra": {
      "eas": {
        "projectId": "b19a93b4-f755-42ec-86a7-115c8b5ac098"
      }
    }
  }
}

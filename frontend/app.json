{
  "expo": {
    "name": "Dearly",
    "slug": "dearly",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/dearly-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mayanksharma.dearly",
      "buildNumber": "18"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFBFE",
        "foregroundImage": "./assets/dearly-adaptive-foreground.png",
        "monochromeImage": "./assets/dearly-adaptive-monochrome.png"
      },
      "package": "com.mayanksharma.dearly",
      "googleServicesFile": "./google-services.json",
      "versionCode": 18,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/dearly-favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Dearly to record a voice note when you choose Record voice.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Dearly to select a photo or video for your private draft.",
          "cameraPermission": false,
          "microphonePermission": "Allow Dearly to record a voice note when you choose Record voice."
        }
      ],
      "expo-asset",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true,
          "enableFTS": false
        }
      ]
    ],
    "scheme": "dearly",
    "extra": {}
  }
}

# Dearly mobile configuration — public/build values only. Never add server secrets.

# 01 · Runtime selection
# Hosted is preferred. Set EXPO_PUBLIC_API_TARGET=local only for deliberate development testing.
EXPO_PUBLIC_APP_ENV="development"
EXPO_PUBLIC_API_TARGET="hosted"

# 02 · Backend addresses
# A phone cannot reach this Mac via localhost; use deliberate LAN/USB setup for local testing.
EXPO_PUBLIC_API_URL="http://localhost:8080"
EXPO_PUBLIC_SERVER_API_URL="https://dearly-z8zm.onrender.com"

# 03 · Expo build identity
# Public identifiers; provide the real owner/project before building a release.
EXPO_OWNER=""
EXPO_PUBLIC_PROJECT_ID=""

# Public API URLs only; never put database credentials here.
# Secondary development backend (run it separately on port 8080).
EXPO_PUBLIC_API_URL=http://localhost:8080
# Preferred backend for development and release builds.
EXPO_PUBLIC_SERVER_API_URL=https://dearly-z8zm.onrender.com
EXPO_PUBLIC_APP_ENV=development
# Optional development override; release builds reject local.
# Set local only for an intentional development override.
EXPO_PUBLIC_API_TARGET=hosted
# Build identity; these are public identifiers, never provider credentials.
EXPO_OWNER=
EXPO_PUBLIC_PROJECT_ID=
